<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" prefHeight="488.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/25"
            fx:controller="fi.jyu.ohj2.kosti.kulujenSeuranta.controller.MainController">

    <top>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="8.0" left="12.0" right="12.0" top="12.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <children>
                    <VBox prefHeight="46.0" prefWidth="100.0" spacing="4.0">
                        <children>
                            <Label text="Alkupvm"/>
                            <DatePicker fx:id="alkuPvmValitsin" onAction="#handleAlkuPvmValitsin" prefHeight="25.0"
                                        prefWidth="100.0"/>
                        </children>
                    </VBox>

                    <VBox spacing="4.0">
                        <children>
                            <Label text="Loppupvm"/>
                            <DatePicker fx:id="loppuPvmValitsin" onAction="#handleLoppuPvmValitsin" prefHeight="25.0"
                                        prefWidth="100.0"/>
                        </children>
                    </VBox>

                    <ComboBox fx:id="kategoriaBox" onAction="#handleKategoriaBox" prefWidth="150.0"
                              promptText="Kaikki kategoriat">
                        <HBox.margin>
                            <Insets left="20.0"/>
                        </HBox.margin>
                    </ComboBox>
                    <Button fx:id="kategoriaButton" mnemonicParsing="false" onAction="#handleKategoriaButton"
                            text="Muokkaa kategorioita"/>
                    <CheckBox fx:id="vainPakollisetCheck" mnemonicParsing="false" onAction="#handleVainPakolliset"
                              text="Vain pakolliset"/>
                </children>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="12.0" right="12.0" top="0.0"/>
            </padding>

            <TableView fx:id="tapahtumatTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="tyyppiCol" text="Tyyppi"/>
                    <TableColumn fx:id="pvmCol" prefWidth="95.0" text="Pvm"/>
                    <TableColumn fx:id="summaCol" prefWidth="105.0" text="Summa"/>
                    <TableColumn fx:id="aiheCol" prefWidth="176.0" text="Aihe"/>
                    <TableColumn fx:id="kategoriaCol" prefWidth="284.0" text="Kategoria"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" prefWidth="804.0" spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="6.0"/>
            </padding>

            <children>
                <GridPane hgap="8.0" vgap="4.0">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="110.0"/>
                    </columnConstraints>
                    <children>
                        <Label text="Menot yhteensä" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="menotYhteensaField" editable="false" prefWidth="110.0"
                                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    </children>
                    <rowConstraints>
                        <RowConstraints/>
                        <RowConstraints/>
                    </rowConstraints>
                </GridPane>

                <GridPane hgap="8.0" vgap="4.0">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="110.0"/>
                    </columnConstraints>
                    <children>
                        <Label text="Tulot yhteensä" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="tulotYhteensaField" editable="false" prefWidth="110.0" GridPane.rowIndex="1"/>
                    </children>
                    <rowConstraints>
                        <RowConstraints/>
                        <RowConstraints/>
                    </rowConstraints>
                </GridPane>

                <Button fx:id="lisaaTuloButton" mnemonicParsing="false" onAction="#handleLisaaTulo" prefHeight="25.0"
                        prefWidth="120.0" text="Lisää tulo 👌">
                    <HBox.margin>
                        <Insets/>
                    </HBox.margin>
                </Button>
                <Button fx:id="lisaaMenoButton" mnemonicParsing="false" onAction="#handleLisaaMeno" prefWidth="120.0"
                        text="Lisää meno 👎">
                    <HBox.margin>
                        <Insets/>
                    </HBox.margin>
                </Button>
                <Button fx:id="muokkaaButton" mnemonicParsing="false" onAction="#handleMuokkaa" prefHeight="25.0"
                        text="Muokkaa"/>
                <Button fx:id="PoistaValittuButton" mnemonicParsing="false" onAction="#handlePoistaValittuButton"
                        text="Poista">
                    <HBox.margin>
                        <Insets/>
                    </HBox.margin>
                </Button>
            </children>
        </HBox>
    </bottom>

</BorderPane>
