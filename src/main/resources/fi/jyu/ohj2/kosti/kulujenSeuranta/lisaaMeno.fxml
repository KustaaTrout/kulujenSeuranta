<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<VBox xmlns:fx="http://javafx.com/fxml/1" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="329.0" prefWidth="313.0" spacing="5.0" xmlns="http://javafx.com/javafx/25"
      fx:controller="fi.jyu.ohj2.kosti.kulujenSeuranta.controller.LisaaMenoController">

    <padding>
        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0"/>
    </padding>
    <children>
        <HBox alignment="CENTER" prefHeight="51.0" prefWidth="253.0">
            <children>
                <Label text="Meno ✍️">
                    <font>
                        <Font name="System Bold" size="15.0"/>
                    </font>
                </Label>
            </children>
        </HBox>
        <Label text="Kategoria"/>
        <ComboBox fx:id="menoKategoria" prefWidth="150.0"/>
        <Label fx:id="mKategoriaVirheLabel" textFill="#807546"/>
        <Label text="Aihe"/>
        <HBox prefHeight="33.0" prefWidth="221.0">
            <children>
                <TextField fx:id="menoTeksti" prefHeight="25.0" prefWidth="206.0"/>
            </children>
        </HBox>
        <Label fx:id="mAiheVirheLabel" textFill="red"/>
        <Label text="Päivämäärä"/>
        <DatePicker fx:id="menoPvmValitsin" prefHeight="25.0" prefWidth="129.0"/>
        <CheckBox fx:id="menoCheckbox" mnemonicParsing="false" text="Pakollinen meno"/>
        <Label text="Summa"/>
        <HBox prefHeight="24.0" prefWidth="221.0">
            <children>
                <TextField fx:id="mSumma" prefHeight="25.0" prefWidth="73.0"/>
                <Button fx:id="mTallenna" mnemonicParsing="false" onAction="#handleMTallenna" text="Tallenna"
                        textFill="#217512">
                    <HBox.margin>
                        <Insets left="10.0" right="10.0"/>
                    </HBox.margin>
                </Button>
                <Button fx:id="mPeruuta" mnemonicParsing="false" onAction="#handleMPeruuta" text="Peruuta"
                        textFill="#a81515"/>
            </children>
        </HBox>
        <Label fx:id="mSummaVirheLabel" textFill="red"/>
    </children>
</VBox>
